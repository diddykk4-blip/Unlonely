<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Allow direct access to existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Allow direct execution of api scripts
  RewriteRule ^api/ - [L]

  # Direct all other routes to index.html for client-side routing
  RewriteRule ^ index.html [L]
</IfModule>
